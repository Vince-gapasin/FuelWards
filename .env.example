# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Both values are safe to ship in the app (the publishable key is public; RLS protects the data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: crash reporting. Create a free Sentry project (React Native) and paste its DSN.
# Leave blank to turn crash reporting off. The DSN is safe to ship in the app.
EXPO_PUBLIC_SENTRY_DSN=
